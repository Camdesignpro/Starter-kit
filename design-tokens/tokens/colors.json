{
  "color": {
    "primitive": {
      "primary": {
        "100": { "$type": "color", "$value": "#FEEFCB" },
        "500": { "$type": "color", "$value": "#EF7D00" },
        "600": { "$type": "color", "$value": "#CD6100" },
        "700": { "$type": "color", "$value": "#AC4900" }
      },

      "secondary": {
        "50": { "$type": "color", "$value": "#F4F6F7" },
        "100": { "$type": "color", "$value": "#E3E7E9" },
        "500": { "$type": "color", "$value": "#4B5156" },
        "700": { "$type": "color", "$value": "#383D41" }
      },

      "neutral": {
        "0": { "$type": "color", "$value": "#FFFFFF" },
        "100": { "$type": "color", "$value": "#F5F5F5" },
        "200": { "$type": "color", "$value": "#EEEEEE" },
        "300": { "$type": "color", "$value": "#E0E0E0" },
        "400": { "$type": "color", "$value": "#BDBDBD" },
        "500": { "$type": "color", "$value": "#9E9E9E" },
        "700": { "$type": "color", "$value": "#616161" }
      },

      "success": {
        "100": { "$type": "color", "$value": "#EFFBCF" },
        "500": { "$type": "color", "$value": "#70BC18" },
        "700": { "$type": "color", "$value": "#3E6E0D" }
      },

      "info": {
        "100": { "$type": "color", "$value": "#D1F8FE" },
        "500": { "$type": "color", "$value": "#1DA5F9" },
        "700": { "$type": "color", "$value": "#0F5F91" }
      },

      "warning": {
        "100": { "$type": "color", "$value": "#FFF5DB" },
        "500": { "$type": "color", "$value": "#FFB14C" },
        "700": { "$type": "color", "$value": "#A86613" }
      },

      "error": {
        "100": { "$type": "color", "$value": "#FFE6D5" },
        "500": { "$type": "color", "$value": "#FF3E30" }
      }
    },

    "semantic": {
      "brand": {
        "default": {
          "$type": "color",
          "$value": "{color.primitive.primary.500}"
        }
      },

      "action": {
        "default": {
          "$type": "color",
          "$value": "{color.primitive.primary.600}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.primitive.primary.700}"
        },
        "focus": {
          "$type": "color",
          "$value": "{color.primitive.primary.600}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.primitive.neutral.300}"
        }
      },

      "text": {
        "primary": {
          "$type": "color",
          "$value": "{color.primitive.secondary.500}"
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.primitive.neutral.700}"
        },
        "muted": {
          "$type": "color",
          "$value": "{color.primitive.neutral.500}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.primitive.neutral.400}"
        },
        "onAction": {
          "$type": "color",
          "$value": "{color.primitive.neutral.0}"
        }
      },

      "surface": {
        "page": {
          "$type": "color",
          "$value": "{color.primitive.secondary.100}"
        },
        "sidebar": {
          "$type": "color",
          "$value": "{color.primitive.secondary.50}"
        },
        "input": {
          "$type": "color",
          "$value": "{color.primitive.neutral.0}"
        }
      },

      "border": {
        "default": {
          "$type": "color",
          "$value": "{color.primitive.neutral.300}"
        },
        "focus": {
          "$type": "color",
          "$value": "{color.primitive.primary.500}"
        },
        "brand": {
          "$type": "color",
          "$value": "{color.primitive.primary.700}"
        }
      },

      "support": {
        "success": {
          "$type": "color",
          "$value": "{color.primitive.success.500}"
        },
        "info": {
          "$type": "color",
          "$value": "{color.primitive.info.500}"
        },
        "warning": {
          "$type": "color",
          "$value": "{color.primitive.warning.500}"
        },
        "error": {
          "$type": "color",
          "$value": "{color.primitive.error.500}"
        }
      }
    }
  }
}
